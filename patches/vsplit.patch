+void
+vsplit(Monitor *m)
+{
+    int i, n = 0;
+    Client *c;
+
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen)
+			n++;
+	if (n == 0)
+		return;
+
+    i = 0;
+    wl_list_for_each(c, &clients, link) {
+        if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+            continue;
+        resize(c, (struct wlr_box){
+            .x = m->w.x + i * m->w.width / n,
+            .y = m->w.y,
+            .width = (i + 1) * m->w.width / n - i * m->w.width / n,
+            .height = m->w.height
+        }, 0);
+        i++;
+    }
+}
